# Copy this file to .env.local and restart `npm run dev` after changes.

# Which AI runs the interviewer:
#   ollama    - free, runs on this computer, stories never leave it (default)
#   groq      - free tier in the cloud (needs GROQ_API_KEY from console.groq.com)
#   gemini    - free tier in the cloud (needs GEMINI_API_KEY from aistudio.google.com;
#               free-tier prompts may be used by Google to improve its products)
#   anthropic - Claude, paid (needs ANTHROPIC_API_KEY)
#   scripted  - no AI, built-in question list
AI_PROVIDER=ollama

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
